{
  "name": "@dayoun/korea-stats-mcp",
  "version": "1.2.0",
  "description": "한국 통계청 KOSIS OpenAPI 기반 MCP 서버 — 자연어로 국가통계를 조회한다. MCP server for Korean national statistics (KOSIS).",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "korea-stats-mcp": "dist/index.js"
  },
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/Dayoooun/korea-stats-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dayoooun/korea-stats-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Dayoooun/korea-stats-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kosis",
    "statistics",
    "korea",
    "openapi",
    "ai",
    "llm"
  ],
  "author": "Dayoun Kim <dayoooun@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "node-cache": "^5.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.11.0",
    "@vercel/node": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
