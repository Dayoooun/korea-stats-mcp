{
  "name": "@kimdayoun/korea-stats-mcp",
  "version": "2.0.0",
  "description": "한국 통계청 KOSIS OpenAPI 기반 MCP 서버 — 자연어로 국가통계를 조회한다. MCP server for Korean national statistics (KOSIS).",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "korea-stats-mcp": "dist/index.js"
  },
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/Dayoooun/korea-stats-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dayoooun/korea-stats-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Dayoooun/korea-stats-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspector": "mcp-inspector node dist/index.js",
    "test": "playwright test",
    "test:core": "pnpm run build && node --test tests/*.test.mjs",
    "test:offline": "playwright test --project=offline",
    "test:live": "playwright test --project=live",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kosis",
    "statistics",
    "korea",
    "openapi",
    "ai",
    "llm"
  ],
  "author": "Dayoun Kim <dayoooun@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.6.1",
    "linkedom": "^0.18.13",
    "node-cache": "^5.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vercel/node": "^3.2.29",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
